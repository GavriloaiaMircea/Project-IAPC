# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL + pgvector
POSTGRES_DB=edupulse
POSTGRES_USER=edupulse
POSTGRES_PASSWORD=

# LLM / embedding provider API key
LLM_API_KEY=

# Must match the embedding model (1536 for text-embedding-3-small)
EMBEDDING_DIMENSIONS=1536

# Chunking
APP_CHUNK_SIZE=800
APP_CHUNK_OVERLAP=100
