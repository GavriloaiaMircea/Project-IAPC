# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL + pgvector
POSTGRES_DB=edupulse
POSTGRES_USER=edupulse
# Host port; 5433 avoids clashing with a locally installed PostgreSQL
DB_PORT=5433
POSTGRES_PASSWORD=

# Embeddings run locally in the ollama container, so no API key is needed.
# EMBEDDING_DIMENSIONS must match the model (768 for nomic-embed-text).
# Changing the model later means re-indexing.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# Chunking (characters)
APP_CHUNK_SIZE=1000
APP_CHUNK_OVERLAP=150
